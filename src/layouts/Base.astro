---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { Font } from "astro:assets";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/global.css";
import "../styles/variables.css";
import "../styles/tokens.css";
import "../styles/theme.css";
import "../styles/craft.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;

const menu = menuResult.data;

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const navItems = menu?.items?.length
	? menu.items.map((i) => ({ label: i.label, url: i.url, target: i.target }))
	: [
			{ label: "Home", url: "/", target: undefined },
			{ label: "Publications", url: "/posts", target: undefined },
		];
const isActive = (url: string) =>
	url === "/" ? pathname === "/" : pathname === url.replace(/\/$/, "") || pathname.startsWith(url.replace(/\/$/, "") + "/");
// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-display" preload />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<script is:inline>
			// Default to dark corporate theme unless explicitly set to light
			(function () {
				try {
					var row = document.cookie.split("; ").find(function (item) {
						return item.startsWith("theme=");
					});
					var theme = row ? row.slice(6) : "dark";
					if (theme === "light") {
						document.documentElement.classList.remove("dark");
						document.documentElement.classList.add("light");
					} else {
						document.documentElement.classList.add("dark");
					}
				} catch (_) {}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="cf-header">
			<a href="/" class="cf-cap cf-brand" aria-label={siteTitle}>
				<span class="cf-mark" aria-hidden="true">D</span>
				<span class="cf-brand-text">Digitas</span>
			</a>

			<nav class="cf-cap cf-pillnav" aria-label="Primary">
				<span class="cf-hover-pill" aria-hidden="true"></span>
				{
					navItems.map((item) => (
						<a
							href={item.url}
							target={item.target}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
							aria-current={isActive(item.url) ? "page" : undefined}
							class:list={["cf-link", { "is-active": isActive(item.url) }]}
						>
							{item.label}
						</a>
					))
				}
			</nav>

			<div class="cf-cap cf-utility">
				<button type="button" class="cf-icon" data-search-open aria-label="Search (Ctrl K)">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
					<kbd class="cf-kbd">⌘K</kbd>
				</button>
				<button type="button" class="cf-icon" data-theme-toggle aria-label="Toggle theme">
					<svg class="cf-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
					<svg class="cf-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
				</button>
				<a href={isLoggedIn ? "/_emdash/admin" : "/_emdash/admin/login"} class="cf-studio">Studio</a>
			</div>
		</header>

		<nav class="cf-bottom" aria-label="Mobile">
			{
				navItems.slice(0, 3).map((item) => (
					<a href={item.url} class:list={["cf-b-link", { "is-active": isActive(item.url) }]} aria-current={isActive(item.url) ? "page" : undefined}>
						{item.label}
					</a>
				))
			}
			<button type="button" class="cf-b-icon" data-search-open aria-label="Search">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
			</button>
			<button type="button" class="cf-b-icon" data-theme-toggle aria-label="Toggle theme">
				<svg class="cf-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
				<svg class="cf-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
			</button>
		</nav>

		<dialog class="cf-search" id="cf-search">
			<div class="cf-search-box">
				<LiveSearch
					placeholder="Search publications…"
					class="site-search"
					inputClass="site-search-input"
					resultsClass="site-search-results"
					resultClass="site-search-result"
					collections={["posts", "pages"]}
				/>
				<p class="cf-search-hint">Esc to close</p>
			</div>
		</dialog>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="ft-inner">
				<section class="ft-cta">
					<p class="ft-tag">Let's Connect</p>
					<h2 class="ft-headline">Ready to engineer your next leap?</h2>
					<p class="ft-sub">Whether you need a full product team, a specialized engineering squad, or growth architecture that ranks.</p>
					<div class="ft-actions">
						<a class="ft-btn ft-btn-primary" href="mailto:tengkuhaidi@gmail.com?subject=New%20project">Start a Project →</a>
						<a class="ft-btn" href="https://legalizin.com" target="_blank" rel="noopener noreferrer">Explore Legalizin.com ↗</a>
					</div>
				</section>

				<div class="ft-grid">
					<div class="ft-col ft-brand">
						<a href="/" class="ft-mono" aria-label="Digitas home">D</a>
						<p class="ft-company">PT Digitas Solusi Indonesia</p>
						<p class="ft-mission">Engineering studio building resilient products, systems and growth infrastructure from Jakarta.</p>
						<p class="ft-clock"><span data-jkt-time>Jakarta · UTC+7</span></p>
						<p class="ft-status"><span class="ft-dot" aria-hidden="true"></span>Accepting select enterprise projects</p>
					</div>
					<nav class="ft-col" aria-label="Capabilities">
						<h3 class="ft-h">Capabilities</h3>
						<ul>
							<li><a href="/#services">Web &amp; Systems</a></li>
							<li><a href="/#services">Mobile Apps</a></li>
							<li><a href="/#services">Product UI/UX</a></li>
							<li><a href="/#services">SEO/SEM Growth</a></li>
							<li><a href="/#services">Brand &amp; Graphic Design</a></li>
							<li><a href="/#services">Problem Solving</a></li>
						</ul>
					</nav>
					<nav class="ft-col" aria-label="Ventures">
						<h3 class="ft-h">Ventures &amp; Ecosystem</h3>
						<ul>
							<li><a href="https://legalizin.com" target="_blank" rel="noopener noreferrer">Legalizin.com <small>Flagship RegTech</small></a></li>
							<li><a href="/#services">Digitas Cloud</a></li>
							<li><a href="/#services">Research Labs</a></li>
						</ul>
					</nav>
					<nav class="ft-col" aria-label="Contact">
						<h3 class="ft-h">Reach Out</h3>
						<ul>
							<li><a href="https://wa.me/6287825174624" target="_blank" rel="noopener noreferrer">WhatsApp <small>+62 878-2517-4624</small></a></li>
							<li><a href="mailto:tengkuhaidi@gmail.com">Email <small>tengkuhaidi@gmail.com</small></a></li>
							<li><a href="https://github.com/lucasmarkes" target="_blank" rel="noopener noreferrer">GitHub</a></li>
							<li><a href="/_emdash/admin">Studio Admin</a></li>
						</ul>
					</nav>
				</div>

				<div class="ft-bottom">
					<p class="ft-copy">© 2026 PT Digitas Solusi Indonesia. All rights reserved.</p>
					<p class="ft-craft">Crafted on Cloudflare Edge · Zero AI Slop</p>
					<div class="ft-controls">
						<div class="theme-switcher">
						<button
							type="button"
							class="theme-btn"
							data-theme="light"
							aria-label="Light mode"
						>
							<svg
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								><circle cx="12" cy="12" r="5"></circle><line
									x1="12"
									y1="1"
									x2="12"
									y2="3"></line><line x1="12" y1="21" x2="12" y2="23"
								></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"
								></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"
								></line><line x1="1" y1="12" x2="3" y2="12"></line><line
									x1="21"
									y1="12"
									x2="23"
									y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"
								></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"
								></line></svg
							>
						</button>
						<button
							type="button"
							class="theme-btn"
							data-theme="dark"
							aria-label="Dark mode"
						>
							<svg
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
								></path></svg
							>
						</button>
						<button
							type="button"
							class="theme-btn"
							data-theme="system"
							aria-label="System theme"
						>
							<svg
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								><rect x="2" y="3" width="20" height="14" rx="2" ry="2"
								></rect><line x1="8" y1="21" x2="16" y2="21"></line><line
									x1="12"
									y1="17"
									x2="12"
									y2="21"></line></svg
							>
						</button>
					</div>
						<a class="ft-top" href="#top" aria-label="Back to top" onclick="event.preventDefault();window.scrollTo({top:0,behavior:'smooth'})">↑</a>
					</div>
				</div>
			</div>
		</footer>

		<script>
			// Jakarta live clock
			const jkt = document.querySelector("[data-jkt-time]");
			const tick = () => { if (jkt) jkt.textContent = "Jakarta · UTC+7 · " + new Date().toLocaleTimeString("en-GB", { timeZone: "Asia/Jakarta", hour: "2-digit", minute: "2-digit" }) + " WIB"; };
			tick(); setInterval(tick, 30000);

			// Theme switcher
			const themeBtns =
				document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			const root = document.documentElement;

			function setCookie(
				name: string,
				value: string,
				maxAge: number = 31536000,
			) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (value === "") {
					document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
					document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
				}
			}

			function setTheme(theme: string) {
				if (theme === "system") {
					setCookie("theme", "");
					root.classList.remove("light", "dark");
				} else {
					setCookie("theme", theme);
					root.classList.remove("light", "dark");
					root.classList.add(theme);
				}
				updateActiveBtn(theme);
			}

			function updateActiveBtn(theme: string) {
				themeBtns.forEach((btn) => {
					const active = btn.dataset.theme === theme;
					btn.classList.toggle("active", active);
					btn.setAttribute("aria-pressed", String(active));
				});
			}

			function getStoredTheme(): string {
				const row = document.cookie
					.split("; ")
					.find((item) => item.startsWith("theme="));
				return row?.slice(6) || "dark";
			}

			// Initialize
			const storedTheme = getStoredTheme();
			setTheme(storedTheme);

			themeBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					setTheme(btn.dataset.theme || "system");
				});
			});
			document.querySelectorAll("[data-theme-toggle]").forEach((b) =>
				b.addEventListener("click", () =>
					setTheme(root.classList.contains("light") ? "dark" : "light"),
				),
			);
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				/*
				 * Design tokens live in src/styles/tokens.css. Colors are
				 * defined with light-dark(); these rules pin the scheme when
				 * the footer switcher sets an explicit choice. With no class,
				 * color-scheme: light dark follows the OS preference. The
				 * @supports guard keeps the toggle from forcing dark UA form
				 * controls on browsers stuck on the plain-light fallback.
				 */
				@supports (color: light-dark(#000, #fff)) {
					:root.light {
						color-scheme: light;
					}

					:root.dark {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-relaxed);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
					min-height: 100vh;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: var(--color-brand);
					text-decoration: none;
					transition: color var(--transition-fast);
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
					color: var(--color-brand-hover);
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					line-height: var(--leading-tight);
					font-weight: var(--font-weight-heading);
					letter-spacing: var(--tracking-snug);
				}

				h1 {
					font-weight: var(--font-weight-display);
					letter-spacing: var(--tracking-tight);
				}

				::selection {
					background: var(--color-brand);
					color: var(--color-on-brand);
				}
			}
		</style>

		<style>
			/* ---- Modern Craft floating header ---- */
			.cf-header {
				position: fixed;
				top: 14px;
				left: 0;
				right: 0;
				z-index: 100;
				display: grid;
				grid-template-columns: 1fr auto 1fr;
				align-items: center;
				gap: 12px;
				padding: 0 20px;
				pointer-events: none;
			}
			.cf-cap {
				pointer-events: auto;
				display: flex;
				align-items: center;
				height: 48px;
				padding: 0 6px;
				border-radius: 999px;
				background: color-mix(in srgb, var(--cf-bg) 72%, transparent);
				border: 1px solid var(--cf-border);
				backdrop-filter: blur(18px) saturate(1.4);
				-webkit-backdrop-filter: blur(18px) saturate(1.4);
				box-shadow: 0 8px 30px -12px rgba(0, 0, 0, 0.5);
			}
			.cf-brand { justify-self: start; gap: 10px; padding: 0 16px 0 6px; color: var(--cf-fg) !important; }
			.cf-mark {
				display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%;
				background: var(--cf-inv-bg); color: var(--cf-inv-fg);
				font: 800 15px/1 var(--font-display, sans-serif);
			}
			.cf-brand-text { font: 600 15px/1 var(--font-display, sans-serif); letter-spacing: -0.02em; }
			.cf-pillnav { position: relative; gap: 2px; padding: 0 4px; }
			.cf-hover-pill {
				position: absolute; left: 0; top: 5px; bottom: 5px; border-radius: 999px;
				background: var(--cf-raised); border: 1px solid var(--cf-border);
				opacity: 0; width: 0;
				transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), width 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s;
			}
			.cf-link {
				position: relative; z-index: 1; padding: 0 16px; line-height: 36px;
				font: 500 13.5px/36px var(--font-body, sans-serif);
				color: var(--cf-muted) !important; transition: color 0.2s;
			}
			.cf-link:hover, .cf-link.is-active { color: var(--cf-fg) !important; }
			.cf-utility { justify-self: end; gap: 4px; padding: 0 6px; }
			.cf-icon {
				display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 11px;
				border: 0; border-radius: 999px; background: transparent; color: var(--cf-muted);
				cursor: pointer; transition: background 0.2s, color 0.2s, transform 0.2s;
			}
			.cf-icon:hover { background: var(--cf-raised); color: var(--cf-fg); }
			.cf-icon:active { transform: scale(0.92); }
			.cf-kbd {
				font: 500 11px/1 var(--font-mono, monospace); padding: 3px 6px; border-radius: 6px;
				border: 1px solid var(--cf-border); color: var(--cf-dim);
			}
			.cf-studio {
				display: inline-flex; align-items: center; height: 36px; padding: 0 16px; margin-left: 2px;
				border-radius: 999px; background: var(--cf-inv-bg); color: var(--cf-inv-fg) !important;
				font: 600 13.5px/1 var(--font-body, sans-serif); transition: transform 0.2s, opacity 0.2s;
			}
			.cf-studio:hover { opacity: 0.88; }
			.cf-studio:active { transform: scale(0.95); }
			.cf-sun { display: none; }
			:root.light .cf-sun { display: block; }
			:root.light .cf-moon { display: none; }

			/* Search dialog */
			.cf-search {
				margin: 14vh auto 0; padding: 0; width: min(560px, calc(100vw - 32px)); border: 1px solid var(--cf-border);
				border-radius: 24px; background: var(--cf-card); color: var(--cf-fg); overflow: visible;
			}
			.cf-search::backdrop { background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(6px); }
			.cf-search-box { padding: 14px; }
			.cf-search :global(.site-search), .cf-search :global(.site-search-input) { width: 100%; }
			.cf-search :global(.site-search-input) { border-radius: 999px; padding: 12px 18px; background: var(--cf-bg); border-color: var(--cf-border); color: var(--cf-fg); }
			.cf-search :global(.site-search-results) { position: static; margin-top: 10px; box-shadow: none; background: transparent; border-radius: 16px; }
			.cf-search-hint { margin: 10px 6px 0; font-size: 11px; color: var(--cf-dim); }

			/* Mobile floating bottom capsule */
			.cf-bottom { display: none; }
			@media (max-width: 767px) {
				.cf-pillnav, .cf-kbd, .cf-utility .cf-icon, .cf-utility .cf-studio { display: none; }
				.cf-header { grid-template-columns: 1fr auto; top: 10px; padding: 0 12px; }
				.cf-utility { padding: 0 4px; }
				.cf-utility .cf-studio { display: inline-flex; height: 34px; padding: 0 14px; }
				.cf-bottom {
					position: fixed; z-index: 100; left: 50%; bottom: max(14px, env(safe-area-inset-bottom));
					transform: translateX(-50%); display: flex; align-items: center; gap: 2px;
					max-width: calc(100vw - 24px); height: 56px; padding: 0 8px; border-radius: 999px;
					background: color-mix(in srgb, var(--cf-bg) 78%, transparent);
					border: 1px solid var(--cf-border); backdrop-filter: blur(18px) saturate(1.4);
					-webkit-backdrop-filter: blur(18px) saturate(1.4); box-shadow: 0 12px 40px -10px rgba(0, 0, 0, 0.7);
				}
				.cf-b-link {
					padding: 0 14px; line-height: 40px; border-radius: 999px; font: 500 13px/40px var(--font-body, sans-serif);
					color: var(--cf-muted) !important; white-space: nowrap; transition: background 0.2s, color 0.2s;
				}
				.cf-b-link.is-active { background: var(--cf-inv-bg); color: var(--cf-inv-fg) !important; }
				.cf-b-icon {
					display: grid; place-items: center; width: 40px; height: 40px; border: 0; border-radius: 50%;
					background: transparent; color: var(--cf-muted); cursor: pointer;
				}
				.cf-b-icon:active { background: var(--cf-raised); transform: scale(0.9); }
			}
			@media (prefers-reduced-motion: reduce) { .cf-hover-pill { transition: none; } }

			/* Search styling */
			.site-search {
				position: relative;
				width: var(--search-input-width);
				--emdash-search-border-focus: var(--color-brand);
			}

			:global(.site-search-input) {
				width: var(--search-input-width);
				padding: var(--spacing-2) var(--spacing-3);
				font-family: var(--font-body);
				font-size: var(--font-size-sm);
				border: 1px solid var(--color-border);
				border-radius: var(--radius);
				background: var(--color-bg);
				color: var(--color-text);
				transition:
					border-color var(--transition-fast),
					box-shadow var(--transition-fast);
			}

			:global(.site-search-input)::placeholder {
				color: var(--color-muted);
			}

			:global(.site-search-input):focus,
			:global(.site-search-input):focus-visible {
				outline: none;
				border-color: var(--color-brand) !important;
				box-shadow: 0 0 0 3px var(--color-brand-ring);
			}

			:global(.site-search-results) {
				position: absolute;
				top: 100%;
				left: 0;
				right: 0;
				margin-top: var(--spacing-2);
				background: var(--color-bg);
				border: 1px solid var(--color-border);
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-lg);
				max-height: 400px;
				overflow-y: auto;
				z-index: 1000;
			}

			:global(.site-search-results .emdash-live-search-loading),
			:global(.site-search-results .emdash-live-search-no-results) {
				padding: var(--spacing-4);
				text-align: center;
				color: var(--color-muted);
				font-size: var(--font-size-sm);
			}

			:global(.site-search-result) {
				display: block;
				padding: var(--spacing-3) var(--spacing-4);
				text-decoration: none;
				color: var(--color-text);
				border-bottom: 1px solid var(--color-border-subtle);
				transition: background var(--transition-fast);
			}

			:global(.site-search-result):last-child {
				border-bottom: none;
			}

			:global(.site-search-result):hover,
			:global(.site-search-result):focus,
			:global(.site-search-result.focused) {
				background: var(--color-surface);
				outline: none;
			}

			:global(.site-search-result .emdash-live-search-result-title) {
				display: block;
				font-weight: 500;
				font-size: var(--font-size-sm);
			}

			:global(.site-search-result .emdash-live-search-result-collection) {
				display: block;
				font-size: var(--font-size-xs);
				color: var(--color-muted);
				text-transform: uppercase;
				letter-spacing: var(--tracking-wide);
				margin-top: 2px;
			}

			:global(.site-search-result .emdash-live-search-result-snippet) {
				display: block;
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				margin-top: var(--spacing-1);
				line-height: var(--leading-snug);
			}

			:global(.site-search-result .emdash-live-search-result-snippet mark) {
				font-weight: 600;
				color: var(--color-text);
			}

			main {
				min-height: 80vh;
			}
			/* Footer */
			.site-footer { background: var(--cf-bg); border-top: 1px solid var(--cf-border); color: var(--cf-fg); }
			.ft-inner { max-width: 72rem; margin: 0 auto; padding: 4rem 1.25rem 2rem; }
			.ft-cta { padding: 3rem 0 4rem; border-bottom: 1px solid var(--cf-border); }
			.ft-tag { font-family: var(--cf-mono, ui-monospace, monospace); font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--cf-accent); margin-bottom: 1rem; }
			.ft-headline { font-size: clamp(2.25rem, 7vw, 5rem); font-weight: 700; letter-spacing: -0.045em; line-height: 0.98; max-width: 14ch; color: var(--cf-fg); text-wrap: balance; }
			.ft-sub { margin-top: 1.5rem; max-width: 40rem; color: var(--cf-muted); line-height: 1.6; }
			.ft-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
			.ft-btn { display: inline-flex; align-items: center; padding: 0.85rem 1.5rem; border-radius: 999px; border: 1px solid var(--cf-border); color: var(--cf-fg); font-weight: 500; font-size: 0.95rem; text-decoration: none; transition: background 0.2s, border-color 0.2s; }
			.ft-btn:hover { background: var(--cf-raised); border-color: var(--cf-dim); }
			.ft-btn-primary { background: var(--cf-inv-bg); color: var(--cf-inv-fg); border-color: var(--cf-inv-bg); }
			.ft-btn-primary:hover { background: var(--cf-inv-bg); opacity: 0.88; }
			.ft-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; border-bottom: 1px solid var(--cf-border); }
			.ft-col { padding: 2.5rem 1.5rem; border-left: 1px solid var(--cf-border); min-width: 0; }
			.ft-col:first-child { border-left: 0; padding-left: 0; }
			.ft-mono { display: inline-flex; align-items: center; justify-content: center; width: 2.5rem; height: 2.5rem; border-radius: 12px; background: var(--cf-inv-bg); color: var(--cf-inv-fg); font-weight: 700; font-size: 1.25rem; text-decoration: none; }
			.ft-company { margin-top: 1rem; font-weight: 600; color: var(--cf-fg); }
			.ft-mission { margin-top: 0.5rem; font-size: 0.875rem; line-height: 1.6; color: var(--cf-muted); max-width: 26rem; }
			.ft-clock { margin-top: 1.5rem; font-family: var(--cf-mono, ui-monospace, monospace); font-size: 0.75rem; color: var(--cf-dim); }
			.ft-status { margin-top: 0.5rem; display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--cf-muted); }
			.ft-dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 0 rgba(34,197,94,0.6); animation: ft-pulse 2s infinite; }
			@keyframes ft-pulse { 70% { box-shadow: 0 0 0 8px rgba(34,197,94,0); } 100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); } }
			@media (prefers-reduced-motion: reduce) { .ft-dot { animation: none; } }
			.ft-h { font-family: var(--cf-mono, ui-monospace, monospace); font-size: 0.7rem; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase; color: var(--cf-dim); margin-bottom: 1.25rem; }
			.ft-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
			.ft-col li a { display: flex; flex-direction: column; color: var(--cf-muted); text-decoration: none; font-size: 0.9rem; transition: color 0.2s; }
			.ft-col li a:hover { color: var(--cf-fg); }
			.ft-col li small { font-size: 0.72rem; color: var(--cf-dim); margin-top: 2px; overflow-wrap: anywhere; }
			.ft-bottom { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; padding-top: 1.5rem; font-size: 0.78rem; color: var(--cf-dim); }
			.ft-craft { text-align: center; font-family: var(--cf-mono, ui-monospace, monospace); }
			.ft-controls { display: flex; align-items: center; justify-content: flex-end; gap: 0.5rem; }
			.ft-top { display: inline-flex; align-items: center; justify-content: center; width: 2.25rem; height: 2.25rem; border: 1px solid var(--cf-border); border-radius: 999px; color: var(--cf-muted); text-decoration: none; transition: background 0.2s, color 0.2s; }
			.ft-top:hover { background: var(--cf-raised); color: var(--cf-fg); }

			/* Theme switcher */
			.theme-switcher {
				display: flex;
				gap: var(--spacing-1);
				padding: var(--spacing-1);
				background: var(--cf-card);
				border: 1px solid var(--cf-border);
				border-radius: 999px;
			}

			.theme-btn {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 32px;
				height: 28px;
				background: transparent;
				border: none;
				color: var(--cf-muted);
				border-radius: 999px;
				cursor: pointer;
				transition: all var(--transition-fast);
			}

			.theme-btn:hover {
				color: var(--color-text-secondary);
			}

			.theme-btn.active {
				background: var(--cf-raised);
				color: var(--cf-fg);
			}

			.theme-btn svg {
				width: 16px;
				height: 16px;
			}

			@media (max-width: 900px) {
				.ft-grid { grid-template-columns: 1fr 1fr; }
				.ft-brand { grid-column: span 2; border-bottom: 1px solid var(--cf-border); padding-right: 0; }
				.ft-col:nth-child(2) { border-left: 0; padding-left: 0; }
				.ft-col:nth-child(4) { border-left: 0; padding-left: 0; border-top: 0; }
			}
			@media (max-width: 767px) {
				.ft-inner { padding-bottom: 6.5rem; }
			}
			@media (max-width: 640px) {
				.ft-cta { padding: 1.5rem 0 3rem; }
				.ft-grid { grid-template-columns: 1fr; }
				.ft-brand { grid-column: auto; }
				.ft-col, .ft-col:nth-child(n) { border-left: 0; padding-left: 0; padding-right: 0; border-bottom: 1px solid var(--cf-border); }
				.ft-col:last-child { border-bottom: 0; }
				.ft-bottom { grid-template-columns: 1fr; text-align: center; }
				.ft-craft { order: 3; }
				.ft-controls { justify-content: center; }
				.ft-btn { flex: 1 1 100%; justify-content: center; }
			}
		</style>

		<script>
			const dlg = document.getElementById("cf-search") as HTMLDialogElement;
			const openSearch = () => {
				if (!dlg.open) dlg.showModal();
				(dlg.querySelector(".site-search-input") as HTMLInputElement | null)?.focus();
			};
			document.querySelectorAll("[data-search-open]").forEach((b) => b.addEventListener("click", openSearch));
			dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
			document.addEventListener("keydown", (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key === "k") {
					e.preventDefault();
					openSearch();
				}
			});

			// Header hover pill: slides under hovered link, rests on active link.
			const nav = document.querySelector(".cf-pillnav") as HTMLElement;
			const pill = nav.querySelector(".cf-hover-pill") as HTMLElement;
			const place = (el: HTMLElement | null) => {
				if (!el) { pill.style.opacity = "0"; return; }
				pill.style.opacity = "1";
				pill.style.width = el.offsetWidth + "px";
				pill.style.transform = `translateX(${el.offsetLeft}px)`;
			};
			const rest = () => place(nav.querySelector(".is-active"));
			nav.querySelectorAll<HTMLElement>(".cf-link").forEach((l) => {
				l.addEventListener("mouseenter", () => place(l));
				l.addEventListener("focus", () => place(l));
			});
			nav.addEventListener("mouseleave", rest);
			nav.addEventListener("focusout", rest);
			rest();
			addEventListener("resize", rest);
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
