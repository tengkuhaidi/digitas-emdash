---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import { HeroAmaterasu } from "../components/HeroAmaterasu";
import { EcosystemAmaterasu } from "../components/EcosystemAmaterasu";
import { ArchitectureAmaterasu } from "../components/ArchitectureAmaterasu";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

// Query latest articles from D1
const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 4,
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Hydrate tags for posts
const tagEntryIds = posts.map((p) => p.data.id);
const tagsByEntry = await getTermsForEntries("posts", tagEntryIds, "tag");

const postsWithTags = posts.map((post) => ({
	post,
	tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
	bylines: post.data.bylines ?? [],
}));
---

<Base title="PT Digitas Solusi Indonesia" description="Architecting Enterprise LegalTech & Resilient Cloud Infrastructure for Southeast Asia">
	<!-- Amaterasu Celestial Sanctuary Hero Atmosphere -->
	<HeroAmaterasu client:load />

	<!-- Amaterasu Editorial Ecosystem Register -->
	<EcosystemAmaterasu client:visible />

	<!-- Amaterasu Architectural Infrastructure Pillars -->
	<ArchitectureAmaterasu client:visible />

	<!-- Editorial Insights & Research Section -->
	<section class="py-28 px-6 sm:px-12 border-t border-[#1b2978]/40 bg-[#070b14]">
		<div class="max-w-6xl mx-auto">
			<div class="flex flex-col sm:flex-row sm:items-end justify-between mb-20">
				<div>
					<div class="flex items-center gap-3 mb-4">
						<span class="w-1.5 h-1.5 rounded-full bg-[#75cdd6]" />
						<span class="text-[10px] uppercase font-mono tracking-[0.32em] text-[#7488a5]">
							03 / RESEARCH & INTELLIGENCE
						</span>
					</div>
					<h2 
						style={{
							fontFamily: 'var(--font-display, "Inter Tight", sans-serif)',
							fontWeight: 200,
							letterSpacing: '-0.035em',
							lineHeight: 1.05
						}}
						className="text-3xl sm:text-5xl md:text-6xl font-extralight text-white tracking-tight"
					>
						Frontier Publications & Regulatory Intelligence
					</h2>
				</div>
				<a
					href="/posts"
					class="inline-flex items-center gap-2 px-5 py-2.5 rounded-[20px] border border-[#1b2978] hover:border-[#75cdd6] bg-transparent text-white hover:text-[#75cdd6] text-[10px] uppercase font-mono tracking-[0.2em] transition-all duration-300 mt-6 sm:mt-0"
				>
					<span>ALL PUBLICATIONS</span>
					<span>&rarr;</span>
				</a>
			</div>

			{posts.length === 0 ? (
				<div class="py-16 border-t border-[#1b2978]/40">
					<p class="text-sm text-[#7488a5] max-w-xl font-normal leading-relaxed">
						Institutional research papers and architectural updates are currently queued for publication. Connect to EmDash Admin to deploy whitepapers.
					</p>
					<div class="mt-8">
						<a
							href="/_emdash/admin/content/posts/new"
							class="inline-flex items-center gap-2 px-5 py-2.5 rounded-[20px] border border-[#1b2978] hover:border-[#75cdd6] bg-transparent text-white hover:text-[#75cdd6] text-[10px] uppercase font-mono tracking-[0.2em] transition duration-300"
						>
							Open Admin Studio
						</a>
					</div>
				</div>
			) : (
				<div class="space-y-0">
					{postsWithTags.map(({ post, tags, bylines }) => (
						<article class="group py-8 border-t border-[#1b2978]/40 grid grid-cols-1 md:grid-cols-12 gap-6 items-baseline hover:bg-[#0c1424]/30 transition-colors px-4 -mx-4">
							<div class="md:col-span-3 text-[11px] font-mono text-[#7488a5] tracking-widest uppercase">
								{post.data.publishedAt ? new Date(post.data.publishedAt).toISOString().split('T')[0] : "RECENT"}
							</div>
							<div class="md:col-span-7">
								<a href={`/posts/${post.id}`} class="block">
									<h3 class="text-lg sm:text-xl text-white font-light group-hover:text-[#75cdd6] transition-colors mb-2 tracking-[-0.01em]">
										{post.data.title ?? "Untitled"}
									</h3>
									{post.data.excerpt && (
										<p class="text-xs text-[#7488a5] line-clamp-2 leading-relaxed">
											{post.data.excerpt}
										</p>
									)}
								</a>
							</div>
							<div class="md:col-span-2 flex md:justify-end">
								<a
									href={`/posts/${post.id}`}
									class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#579dc0] group-hover:text-[#75cdd6] transition-colors"
								>
									READ PAPER &rarr;
								</a>
							</div>
						</article>
					))}
					<div class="border-t border-[#1b2978]/40" />
				</div>
			)}
		</div>
	</section>
</Base>
