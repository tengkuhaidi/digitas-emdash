---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import { HeroCraft } from "../components/HeroCraft";
import { ServicesShowcase } from "../components/ServicesShowcase";
import { InteractiveShowcase } from "../components/InteractiveShowcase";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

// Query latest articles from D1
const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 4,
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Hydrate tags for posts
const tagEntryIds = posts.map((p) => p.data.id);
const tagsByEntry = await getTermsForEntries("posts", tagEntryIds, "tag");

const postsWithTags = posts.map((post) => ({
	post,
	tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
	bylines: post.data.bylines ?? [],
}));
---

<Base title="PT Digitas Solusi Indonesia" description="A design and engineering partner for scale-ups and enterprise products. Web, systems, UI/UX, SEO/SEM, brand and problem solving. Incubator of Legalizin.com.">
	<HeroCraft client:load />
	<ServicesShowcase client:visible />
	<InteractiveShowcase client:visible />

	<section class="px-5 py-20 sm:py-28" style="background: var(--cf-bg)">
		<div class="mx-auto max-w-5xl">
			<div class="mb-10 flex items-end justify-between gap-6">
				<div>
					<p class="cf-mono mb-4 text-xs uppercase tracking-widest" style="color: var(--cf-accent)">Publications</p>
					<h2 class="cf-display text-balance" style="font-weight:700;font-size:clamp(2rem,5vw,3.5rem);letter-spacing:-0.045em;line-height:1;color:var(--cf-fg)">
						Legalizin insights.
					</h2>
				</div>
				<a href="/posts" class="pub-all">All publications <span aria-hidden="true">→</span></a>
			</div>

			{posts.length === 0 ? (
				<div class="pub-empty">
					<p>No publications yet. Add the first one in Studio.</p>
					<a href="/_emdash/admin/content/posts/new" class="pub-all">Open Studio</a>
				</div>
			) : (
				<ul class="pub-list">
					{postsWithTags.map(({ post, tags }) => (
						<li>
							<a href={`/posts/${post.id}`} class="pub-row">
								<time class="pub-date cf-mono">
									{post.data.publishedAt ? new Date(post.data.publishedAt).toISOString().split("T")[0] : "Recent"}
								</time>
								<div class="pub-main">
									<h3 class="pub-title cf-display">{post.data.title ?? "Untitled"}</h3>
									{post.data.excerpt && <p class="pub-excerpt">{post.data.excerpt}</p>}
									{tags.length > 0 && (
										<div class="pub-tags">
											{tags.slice(0, 3).map((t) => <span>{t.label}</span>)}
										</div>
									)}
								</div>
								<span class="pub-arrow" aria-hidden="true">↗</span>
							</a>
						</li>
					))}
				</ul>
			)}
		</div>
	</section>

	<style>
		.pub-all {
			display: inline-flex; align-items: center; gap: 8px; flex-shrink: 0; height: 40px; padding: 0 18px;
			border-radius: 999px; border: 1px solid var(--cf-border); background: var(--cf-card);
			color: var(--cf-fg) !important; font-size: 13.5px; font-weight: 600; transition: transform 0.2s, background 0.2s;
		}
		.pub-all:hover { background: var(--cf-raised); }
		.pub-all:active { transform: scale(0.95); }
		.pub-list { list-style: none; display: grid; gap: 10px; }
		.pub-row {
			display: grid; grid-template-columns: 110px 1fr 28px; gap: 20px; align-items: start; padding: 22px 24px;
			border: 1px solid var(--cf-border); border-radius: 24px; background: var(--cf-card);
			color: var(--cf-fg) !important; transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.2s, background 0.2s;
		}
		.pub-row:hover { transform: translateY(-2px); border-color: var(--cf-dim); background: var(--cf-raised); }
		.pub-date { font-size: 12px; color: var(--cf-dim); padding-top: 6px; }
		.pub-title { font-size: clamp(1.15rem, 2.4vw, 1.5rem); font-weight: 600; letter-spacing: -0.025em; line-height: 1.2; }
		.pub-excerpt { margin-top: 6px; font-size: 14px; color: var(--cf-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
		.pub-tags { display: flex; gap: 6px; margin-top: 12px; flex-wrap: wrap; }
		.pub-tags span { font-size: 11px; padding: 3px 10px; border-radius: 999px; border: 1px solid var(--cf-border); color: var(--cf-muted); }
		.pub-arrow { font-size: 20px; color: var(--cf-dim); transition: transform 0.25s, color 0.2s; }
		.pub-row:hover .pub-arrow { transform: translate(3px, -3px); color: var(--cf-fg); }
		.pub-empty { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; padding: 32px; border: 1px dashed var(--cf-border); border-radius: 24px; color: var(--cf-muted); }
		@media (max-width: 640px) {
			.pub-row { grid-template-columns: 1fr 24px; padding: 18px; }
			.pub-date { grid-column: 1 / -1; padding-top: 0; }
			.pub-main { grid-column: 1; }
			.pub-arrow { grid-column: 2; grid-row: 2; }
		}
	</style>
</Base>
