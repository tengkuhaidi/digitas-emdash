---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { HeroInteractive } from "../components/HeroInteractive";
import { EcosystemGrid } from "../components/EcosystemGrid";
import { TechStackShowcase } from "../components/TechStackShowcase";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

// Query latest articles from D1
const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 6,
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Hydrate tags for posts
const tagEntryIds = posts.map((p) => p.data.id);
const tagsByEntry = await getTermsForEntries("posts", tagEntryIds, "tag");

const postsWithTags = posts.map((post) => ({
	post,
	tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
	bylines: post.data.bylines ?? [],
}));
---

<Base title="PT Digitas Solusi Indonesia" description="Architecting Enterprise LegalTech & Resilient Cloud Infrastructure for Southeast Asia">
	<!-- Interactive Hero Section with Framer Motion -->
	<HeroInteractive client:load />

	<!-- Holding Ecosystem Bento Grid -->
	<EcosystemGrid client:visible />

	<!-- Technical Infrastructure Pillars -->
	<TechStackShowcase client:visible />

	<!-- Corporate Insights & Research Section -->
	<section class="py-20 md:py-28 border-t border-[#1b2978]/40 bg-[#070b14]">
		<div class="max-w-6xl mx-auto px-4">
			<div class="flex flex-col sm:flex-row sm:items-end justify-between mb-16">
				<div>
					<span class="text-[10px] uppercase font-medium tracking-[0.32em] text-[#75cdd6] block mb-3 font-mono">
						Institutional Publications
					</span>
					<h2 class="text-3xl sm:text-4xl md:text-5xl font-extralight text-white tracking-[-0.03em]">
						Executive Insights & Regulatory Tech
					</h2>
				</div>
				<a
					href="/posts"
					class="inline-flex items-center gap-1.5 text-[11px] font-medium uppercase tracking-[0.16em] text-[#75cdd6] hover:text-white transition-colors mt-4 sm:mt-0 font-mono"
				>
					View all research &rarr;
				</a>
			</div>

			{posts.length === 0 ? (
				<div class="text-center py-16 px-6 rounded-[20px] border border-[#1b2978]/60 bg-[#0c1424]/60 max-w-xl mx-auto">
					<div class="w-10 h-10 rounded-[12px] bg-[#070b14] border border-[#1b2978]/60 text-[#75cdd6] flex items-center justify-center mx-auto mb-4 font-mono text-xs font-medium">
						D1
					</div>
					<h3 class="text-base font-medium text-white mb-2">Publishing Pipeline Connected</h3>
					<p class="text-sm text-[#7488a5] leading-[1.4] mb-8 font-normal">
						Cloudflare D1 database and R2 media bucket are fully migrated. Create your first whitepaper or research post directly through the EmDash admin panel.
					</p>
					<a
						href="/_emdash/admin/content/posts/new"
						class="inline-flex items-center justify-center px-6 py-3 rounded-[20px] border border-[#1b2978] hover:border-[#75cdd6] bg-transparent text-white hover:text-[#75cdd6] text-[11px] font-medium tracking-[0.16em] uppercase transition duration-300"
					>
						Open Admin Studio
					</a>
				</div>
			) : (
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					{postsWithTags.map(({ post, tags, bylines }) => (
						<PostCard
							title={post.data.title ?? "Untitled"}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image}
							href={`/posts/${post.id}`}
							date={post.data.publishedAt ?? undefined}
							readingTime={5}
							tags={tags}
							bylines={bylines}
							edit={post.edit}
						/>
					))}
				</div>
			)}
		</div>
	</section>
</Base>
